# ==============================================================================
# VoxPrep — AI Voice Interview Simulator (Environment Configuration)
# ==============================================================================
# LLM keys are supplied per session by the user in the UI (never saved to disk).

# Comma-separated frontend origins allowed for split hosting (e.g. Vercel -> Render)
# Example: ALLOWED_ORIGINS=https://voxprep.vercel.app
ALLOWED_ORIGINS=

# Optional: Server-side OpenAI key for optional OpenAI HD TTS during active sessions
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Default model metadata & security limits
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
MAX_CANDIDATE_TURNS=10
SESSION_TTL_SECONDS=1800
MAX_ACTIVE_SESSIONS=50

# Local dev server configuration (Render sets $PORT automatically)
HOST=127.0.0.1
PORT=8000
